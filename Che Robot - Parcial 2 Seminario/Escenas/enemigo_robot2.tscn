[sub_resource type="GDScript" id="GDScript_yqwl2"]
script/source = "extends ProgressBar

@onready var enemigo_robot: CharacterBody2D = $\"../..\"

@export var offset: Vector2 = Vector2(-45, -25) 

var maxValorVida: int

func _ready() -> void:
	maxValorVida = 100

func recibirDaño(dañoBalaRobot):
	value -= dañoBalaRobot
	if value == 0:
		get_tree().get_nodes_in_group(\"Robot2\")[0].die()

func _process(_delta):
	if enemigo_robot:
		global_position = enemigo_robot.global_position + offset
"

