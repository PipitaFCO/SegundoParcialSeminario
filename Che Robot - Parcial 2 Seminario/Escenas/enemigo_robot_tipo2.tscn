[sub_resource type="GDScript" id="GDScript_pwifj"]
script/source = "extends CharacterBody2D

class_name enemigo_robot_tipo2

@onready var vida_robot_tipo_2: ProgressBar = $Node/VidaRobotTipo2
@onready var sprite: Sprite2D = $Sprite2D


@onready var timer: Timer = $Timer
@onready var hitman: CharacterBody2D = $Hitman

@onready var marcador: Marker2D = $Marker2D

@onready var ray_cast_pared: RayCast2D = $RayCast2D
@onready var ray_cast_jugador: RayCast2D = $RayCast2D2

const BALA_ROBOT = preload(\"uid://bijmdg1l66ksg\")

var velocidad : float = 100.0
var direccion: int = 1
var vida = 100
var player 

func _ready() -> void:
	player = get_tree().get_first_node_in_group(\"Hitman\")
	vida_robot_tipo_2.max_value = vida

func _physics_process(delta: float) -> void:
	apuntar()
	posicionHitman()
	
	if player: 
		look_at(player.global_position)
	
	if ray_cast_pared.is_colliding():
		direccion *= -1
		ray_cast_pared.target_position.x *= -1

	velocity = Vector2(direccion * velocidad, 0)
	move_and_slide()
func girar():
	direccion *= -1
	
	# 2. ESTO ES LO MÁS IMPORTANTE: giramos el rayo también
	ray_cast_pared.target_position.x *= -1

func apuntar():
	ray_cast_jugador.target_position = to_local(player.position)

func posicionHitman():
	if ray_cast_jugador.get_collider() == player and timer.is_stopped():
		timer.start()
	elif ray_cast_jugador.get_collider() != player and not timer.is_stopped():
		timer.stop()
	pass


func _on_timer_timeout() -> void:
	disparar() 
	pass 

func disparar():
		var instanciaDeBala = BALA_ROBOT.instantiate()
		var referencia = ray_cast_jugador.get_collision_point()
		var direc = (referencia - global_position)
		
		get_tree().root.add_child(instanciaDeBala)
		instanciaDeBala.global_position = marcador.global_position
		instanciaDeBala.direction = (direc).normalized()

func terminar_juego() -> void:
	get_tree().reload_current_scene()

func recibirDaño(cantidad):
	vida_robot_tipo_2.value -= cantidad
	if vida_robot_tipo_2.value == 0:
		queue_free()
"

